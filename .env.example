# ==============================================================================
# GitQuest Environment Configuration Example
# Copy this file to .env and configure your secrets locally.
# Never commit real credentials or .env files to version control.
# ==============================================================================

# --- AI Service Configuration (Person 2 Integration) ---
# Google GenAI / Gemini API key for Gemma quest generation
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma / Gemini model identifier (defaults to gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- GitHub Integration Configuration (Person 1 Integration) ---
# Optional GitHub Personal Access Token (increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_token_here

# --- Persistence and Database Configuration ---
# Path to SQLite database file (defaults to gitquest.db)
GITQUEST_DB_PATH=gitquest.db

# --- Gamification and XP Rewards (Server Authoritative) ---
# XP reward for completing Stage A (Training Quest)
GITQUEST_STAGE_A_COMPLETION_XP=50

# Base XP reward for completing Stage B (Open Challenge)
GITQUEST_STAGE_B_COMPLETION_XP=100

# Stage B unlock requirements (both conditions must be satisfied)
GITQUEST_STAGE_B_UNLOCK_XP=200
GITQUEST_STAGE_B_UNLOCK_STAGE_A_COUNT=3

# Progressive hint unlock costs per tier
GITQUEST_HINT_COST_TIER_1=10
GITQUEST_HINT_COST_TIER_2=25
GITQUEST_HINT_COST_TIER_3=50

# Consistency / habit tracking decay parameters
GITQUEST_CONSISTENCY_GRACE_HOURS=48.0
GITQUEST_CONSISTENCY_DECAY_PER_DAY=5.0

# --- Server and Security Configuration ---
# Allowed CORS origins for browser frontend clients (comma-separated)
GITQUEST_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server port
PORT=5000
