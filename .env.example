# GitQuest Environment Configuration Example
# Copy this file to .env and configure your secrets

# GitHub Personal Access Token (optional, increases GitHub API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_token_here

# Google GenAI / Gemini API Key for quest generation
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma / Gemini model identifier (defaults to gemma-4-26b-a4b-it if omitted)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Server configuration
PORT=5000
